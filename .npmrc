# React is pinned to an experimental release because that is the only build that
# exports <ViewTransition>, which the push-in into an exhibit is built on — see
# next.config.ts. Experimental releases are published as 0.0.0-experimental-<sha>,
# which does not satisfy next's `react: ^19.0.0` peer range, so a strict install
# fails to resolve. `npm install` only warns and carries on; `npm ci` treats it as
# an error and exits, which is what a clean checkout on CI does.
legacy-peer-deps=true
